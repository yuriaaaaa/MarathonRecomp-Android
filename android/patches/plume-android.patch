+#if defined(__ANDROID__)
+    // Android: after the app was in the background the old ANativeWindow is gone, and any swap
+    // chain made for its surface fails with VK_ERROR_NATIVE_WINDOW_IN_USE_KHR. Make a new surface.
+    bool VulkanSwapChain::recreateSurfaceIfWindowChanged() {
+        uint32_t generation = 0;
+        ANativeWindow *current = MarathonAndroid_CurrentNativeWindow(&generation);
+        if (current == nullptr) {
+            return false;
+        }
+
+        if ((current == desc.renderWindow) && (generation == windowGeneration)) {
+            return true;
+        }
+
+        VulkanInterface *renderInterface = commandQueue->device->renderInterface;
+        releaseImageViews();
+        releaseSwapChain();
+        if (surface != VK_NULL_HANDLE) {
+            vkDestroySurfaceKHR(renderInterface->instance, surface, nullptr);
+            surface = VK_NULL_HANDLE;
+        }
+
+        desc.renderWindow = current;
+        windowGeneration = generation;
+        VkAndroidSurfaceCreateInfoKHR surfaceCreateInfo = {};
+        surfaceCreateInfo.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+        surfaceCreateInfo.window = current;
+        VkResult res = vkCreateAndroidSurfaceKHR(renderInterface->instance, &surfaceCreateInfo, nullptr, &surface);
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreateAndroidSurfaceKHR failed with error code 0x%X after the window changed.\n", res);
+            surface = VK_NULL_HANDLE;
+            return false;
+        }
+
+        VkBool32 presentSupported = false;
+        vkGetPhysicalDeviceSurfaceSupportKHR(commandQueue->device->physicalDevice, commandQueue->familyIndex, surface, &presentSupported);
+        fprintf(stderr, "Swap chain: new Android window %p, surface remade (present %s).\n", (void *)current, presentSupported ? "supported" : "NOT supported");
+        return true;
+    }
+#endif
+
